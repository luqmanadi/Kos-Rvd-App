{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint"
      ]
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/getDetailAkunPengguna",
        "function": "getDetailAkunPengguna",
        "region": "asia-southeast2"
      },
      {
        "source": "/api/createAkunPengguna",
        "function": "createAkunPengguna",
        "region": "asia-southeast2"
      },
      {
        "source": "/api/deactivateUserAccount",
        "function": "deactivateUserAccount",
        "region": "asia-southeast2"
      },
      {
        "source": "/api/reactivateUserAccount",
        "function": "reactivateUserAccount",
        "region": "asia-southeast2"
      },
      {
        "source": "/api/deleteAccount",
        "function": "deleteAccount",
        "region": "asia-southeast2"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "hosting": {
      "host": "0.0.0.0",
      "port": 5000
    },
    "functions": {
      "host": "0.0.0.0",
      "port": 5001
    },
    "firestore": {
      "host": "0.0.0.0",
      "port": 8080
    },
    "pubsub": {
      "host": "0.0.0.0",
      "port": 8085
    },
    "ui": {
      "enabled": true,
      "host": "0.0.0.0",
      "port": 4000
    },
    "singleProjectMode": true,
    "auth": {
      "host": "0.0.0.0",
      "port": 9099
    },
    "storage": {
      "host": "0.0.0.0",
      "port": 9199
    }
  },
  "storage": {
    "rules": "storage.rules"
  }
}
